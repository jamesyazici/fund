# Copy to .env and fill in.  (runner/.env is gitignored)

# ── backend (Railway) ───────────────────────────────────────────────────
RAILWAY_BACKEND_URL=https://fund-production-3f88.up.railway.app
# Shared secret for the VM -> backend /internal/* endpoints (later phase).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must match the value set on Railway.
INTERNAL_SHARED_SECRET=change-me

# ── market-data hub (Alpaca) ────────────────────────────────────────────
# Free Alpaca data credentials give you the IEX feed. A dedicated data-only
# Alpaca account keeps this decoupled from the pods' trading accounts.
HUB_ALPACA_KEY=
HUB_ALPACA_SECRET=
HUB_FEED=iex
# Union of every symbol your deployed strategies need (until dynamic
# subscription lands with the supervisor):
HUB_SYMBOLS=AAPL,MSFT,NVDA,GOOGL,META,AMZN,TSLA,JPM,V,MA,SPY

# ── bus ─────────────────────────────────────────────────────────────────
NATS_URL=nats://nats:4222

# ── sandbox limits (used by the supervisor) ──────────────────────────────
SANDBOX_CPU=0.5
SANDBOX_MEM=512m
RQFC_EVENT_TIMEOUT_MS=30000
MAX_SYMBOLS_PER_STRATEGY=50
POLL_SECONDS=10
